# Canonical public origin, without a trailing slash.
# Required before a production build. Do not invent a domain.
# Example after the host exists: https://demont.example
PUBLIC_SITE_URL=

# Lead delivery. Configure ONE path. Nothing is stored if both are empty.
# The form then returns an error and asks the visitor to call.

# Resend (transactional email). Verify the sending domain before use.
# Resend processes message content outside your own server. Name it in the privacy policy before enabling.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Or an HTTPS endpoint you control (EU mailbox bridge, mailer, or internal inbox).
# Requests use POST with JSON. Optional bearer secret.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional comma-separated origins allowed to post, in addition to the request host.
# Example: https://demont.example,https://www.demont.example
ALLOWED_ORIGINS=
