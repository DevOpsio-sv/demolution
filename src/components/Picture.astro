---
import type { Photo } from "../data/photos";

interface Props {
  photo: Photo;
  sizes: string;
  priority?: boolean;
  eager?: boolean;
  decorative?: boolean;
  mark?: string;
  active?: boolean;
  altOverride?: string;
  class?: string;
}

const {
  photo,
  sizes,
  priority = false,
  eager = false,
  decorative = false,
  mark,
  active = false,
  altOverride,
  class: className,
} = Astro.props;
const alt = decorative ? "" : (altOverride ?? (active || !mark ? photo.alt : ""));
const hidden = decorative || Boolean(mark && !active);
---

<picture class={className}>
  <source type="image/avif" srcset={photo.avif} sizes={sizes} />
  <source type="image/webp" srcset={photo.webp} sizes={sizes} />
  <img
    src={photo.src}
    alt={alt}
    width={photo.width}
    height={photo.height}
    loading={priority || eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : undefined}
    data-for={mark}
    data-alt={photo.alt}
    class:list={{ "is-active": active }}
    aria-hidden={hidden ? "true" : undefined}
  />
</picture>
