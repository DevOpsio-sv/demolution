---
import Picture from "./Picture.astro";
import { business } from "../data/business";
import { photo } from "../data/photos";

const before = photo("hero");
const after = photo("heroAfter");
const sizes = "(min-width: 1000px) 58vw, 100vw";
---

<section class="hero" id="nachalo" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="kicker">01 / Прецизен демонтаж</p>
    <div>
      <h1 id="hero-title">
        <span>Събаряне и демонтаж.</span>
        <span>Работа с точен план.</span>
      </h1>
      <p class="lede">
        Разрушаване на стари постройки, демонтаж на покриви, стени и конструкции. Обслужваме София, Ловеч, Плевен и околните населени места.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#kontakt">Поискайте оферта</a>
        <a class="btn btn-secondary" href={`tel:${business.phoneE164}`}>Обадете се</a>
      </div>
    </div>
    <p class="geo">София <span>/</span> Ловеч <span>/</span> Плевен</p>
  </div>
  <div class="hero-media">
    <div class="hero-compare" data-hero-compare>
      <div class="hero-compare-frame">
        <Picture photo={before} sizes={sizes} priority class="hero-shot hero-shot-before" />
        <Picture photo={after} sizes={sizes} eager decorative class="hero-shot hero-shot-after" />
        <svg class="hero-seam" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line data-seam-shadow x1="100" y1="0" x2="100" y2="100" />
          <line data-seam x1="100" y1="0" x2="100" y2="100" />
        </svg>
        <p class="hero-compare-label hero-compare-before" aria-hidden="true">Преди</p>
        <p class="hero-compare-label hero-compare-after" aria-hidden="true">След</p>
      </div>
      <p id="hero-compare-help" class="visually-hidden">
        Хоризонтално плъзгане или стрелките местят границата между двете снимки.
      </p>
      <input
        class="hero-compare-slider"
        type="range"
        min="0"
        max="100"
        step="1"
        value="0"
        disabled
        aria-label="Сравнение преди и след"
        aria-describedby="hero-compare-help"
        aria-valuetext="0% след"
      />
    </div>
  </div>
</section>

<script>
  import "../scripts/hero-reveal.ts";
</script>
