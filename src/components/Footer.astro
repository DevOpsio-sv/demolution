---
import { areas, business, navigation } from "../data/business";
import Logo from "./Logo.astro";
import { imageCredits } from "../data/credits";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const home = path === "/";
const hrefFor = (hash: string) => (home ? hash : `/${hash}`);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="logo" href="/">
        <Logo tone="on-dark" />
      </a>     
    </div>
    <nav class="footer-nav" aria-label="Долна навигация">
      {navigation.map((item) => <a href={hrefFor(item.href)}>{item.label}</a>)}
    </nav>  
  </div>
  <div class="footer-bar">
    <p>© {year} {business.provisionalName}. Всички права запазени.</p>
    {business.legalName ? <p>{business.legalName}</p> : null}
    <nav class="footer-legal" aria-label="Правна информация">
      <a href="/poveritelnost">Политика за поверителност</a>
      <a href="/biskvitki">Политика за бисквитките</a>
    </nav>
  </div> 
</footer>
