---
const points = [
  "Оглед на обекта и достъпа",
  "Начин на работа според конструкцията",
  "Внимание към съседни сгради и имоти",
  "Уговорка за отпадъците преди започване",
  "Ясна комуникация за обхват и следващи стъпки",
];
---

<section class="section trust" aria-labelledby="trust-title">
  <div class="wrap">
    <div class="trust-head">
      <div>
        <p class="kicker">02 / Подход</p>
        <h2 id="trust-title">
          Първо преценяваме.
          <br />
          После действаме.
        </h2>
      </div>
      <p class="measure">
        Преди да започнем, разглеждаме обекта, достъпа и съседните постройки. Подбираме начин на демонтаж според конструкцията и обсъждаме как да подходим с отпадъците.
      </p>
    </div>
    <ol class="trust-index">
      {
        points.map((point, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {point}
          </li>
        ))
      }
    </ol>
  </div>
</section>
