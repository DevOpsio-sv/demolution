---
const steps = [
  {
    number: "01",
    title: "Разкажете ни за обекта",
    text: "Обадете се или изпратете запитване. Опишете какво трябва да се премахне, къде се намира и как се стига до него.",
  },
  {
    number: "02",
    title: "Оглед и преценка",
    text: "Разглеждаме конструкцията, достъпа и съседните сгради. Ако трябват разрешение, уведомление или друг специалист, казваме го преди започване.",
  },
  {
    number: "03",
    title: "План и оферта",
    text: "Уточняваме обхвата, начина на работа и какво се случва с отпадъците. Срокът и цената са за конкретния обект, нямаме обща тарифа.",
  },
  {
    number: "04",
    title: "Демонтаж и приключване",
    text: "Работим по уговорения план. След приключване теренът остава в състоянието, което сме уточнили. Товарене и извозване се извършва само ако е договорено предварително.",
  },
];
---

<section class="section process" id="proces" aria-labelledby="proces-title">
  <div class="wrap">
    <p class="kicker kicker-light">04 / Процес</p>
    <h2 id="proces-title">От стара постройка до свободен терен</h2>
    <p class="process-note">
      Срокът, методът, мерките за безопасност и отпадъците зависят от конкретния обект.
    </p>
    <ol class="process-list">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-num">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
