---
import { business, pageMeta } from "../data/business";
import { schemaGraph } from "../data/schema";
import cyrillicFont from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";
import latinFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import "@fontsource-variable/manrope/wght.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyContact from "../components/StickyContact.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: boolean;
}

const {
  title = pageMeta.title,
  description = pageMeta.description,
  noindex = false,
  jsonLd = false,
} = Astro.props;

const origin = Astro.site?.href ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const image = new URL("/og.jpg", origin).href;
const structuredData = jsonLd ? JSON.stringify(schemaGraph(origin)).replace(/</g, "\\u003c") : "";
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#F3F1EC" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={cyrillicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={business.provisionalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Стара стопанска постройка. Илюстративна снимка, не е изпълнен обект." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip" href="#main">Към съдържанието</a>
    <div id="top-sentinel" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyContact />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
